# ============================================
# Hospital Management System - Environment Configuration
# ============================================
# Copy this file to .env for local overrides.
# DO NOT commit .env with real credentials.
# Set these variables in your deployment dashboard (Render/Railway/Vercel).
# ============================================

# Backend: MySQL Database Configuration (from TiDB / Aiven / Railway)
# Example Cloud URL: jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/hospital_management?useSSL=true&verifyServerCertificate=true
DB_URL=jdbc:mysql://localhost:3306/hospital_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Backend: JWT Configuration (minimum 32-character secure random string)
JWT_SECRET=HospitalManagementSystemSecretKeyForJWTTokenGeneration2024SecureKey
JWT_EXPIRATION=86400000

# Backend: Server Port (set automatically by cloud hosts like Render/Railway)
PORT=8080

# Backend: Allowed CORS Origins (comma-separated list of extra origins)
CORS_ALLOWED_ORIGINS=https://your-hospital-frontend.vercel.app

# Frontend: Production API URL (set in Vercel project environment variables)
# If using direct backend calls: https://<your-backend-app>.onrender.com/api
# If using Vercel reverse proxy rewrites: /api
VITE_API_URL=http://localhost:8080/api

